# Copy to .env and fill in. .env is git-ignored.
# Supabase -> your project -> Connect -> "Session pooler" URI (IPv4-compatible, port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_SCHEMA=public
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Leave empty to use ANTHROPIC_API_KEY or an `ant auth login` profile.
LLM_API_KEY=
LLM_EFFORT=high
# Local open-weight model instead: LLM_PROVIDER=ollama, LLM_MODEL=qwen3.5:4b (any `ollama list` name).
# LLM_EFFORT and LLM_API_KEY are ignored for Ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=false
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cuda
EVIDENCE_THRESHOLD=0.14
CAUSE_MATCH_THRESHOLD=0.65
# Rewrite code-less operator queries into manual vocabulary before searching (one short LLM call each).
QUERY_REWRITE=true
REWRITE_EFFORT=low
# Optional: run the rewrite on another model than the diagnosis (empty = same as LLM_PROVIDER/LLM_MODEL),
# e.g. REWRITE_PROVIDER=anthropic + REWRITE_MODEL=claude-sonnet-5-5 with a local Ollama diagnosis.
REWRITE_PROVIDER=
REWRITE_MODEL=
